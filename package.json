{
  "name": "addisdub",
  "version": "0.1.0",
  "description": "Real-time English → Amharic AI dubbing platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:web": "pnpm -C apps/web dev",
    "dev:realtime": "pnpm -C apps/realtime dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm -C apps/web build",
    "build:realtime": "pnpm -C apps/realtime build",
    "start": "pnpm -r run start",
    "lint": "pnpm -r run lint",
    "type-check": "pnpm -r run type-check",
    "docker:up": "docker-compose up",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build"
  },
  "devDependencies": {
    "prettier": "^3.1.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
